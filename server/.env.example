# Copy to .env for local development. Never commit the real .env file.

# HTTP port the local server listens on
PORT=4000

# Directory for SQLite DB, logs, and generated JWT secret.
# In the installed Windows app this resolves to %ProgramData%\OVRLedAssetManagement (see plan §K).
# For local development it defaults to ./data next to this file.
DATA_DIR=./data
